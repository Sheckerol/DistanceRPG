<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>DistanceRPG</AssemblyName>
        <RootNamespace>GameEngine.DistanceRPG</RootNamespace>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GameEngine.DistanceRPG.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenTK" Version="4.9.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\GameEngine\GameEngine.Core\GameEngine.Core.csproj"/>
    </ItemGroup>

    <!-- Copy engine shaders from Core so they're available at runtime -->
    <ItemGroup>
        <Content Include="..\..\GameEngine\GameEngine.Core\Shaders\**\*"
                 Link="Shaders\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The data files (phase-5-save.md 5.3, 5.4): generated from the compiled content
         (the write-data command, run on this Data folder) and pinned byte for byte by
         ShippedDataTests, then copied beside the executable, where the game reads them once
         at startup and a playtest edits them. PreserveNewest leaves a copy edited there alone. -->
    <ItemGroup>
        <None Remove="Data\**" />
        <Content Include="Data\*.json"
                 Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
