<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>DistanceRPG</AssemblyName>
        <RootNamespace>GameEngine.DistanceRPG</RootNamespace>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GameEngine.DistanceRPG.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="OpenTK" Version="4.9.4"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\GameEngine\GameEngine.Core\GameEngine.Core.csproj"/>
    </ItemGroup>

    <!-- Copy engine shaders from Core so they're available at runtime -->
    <ItemGroup>
        <Content Include="..\..\GameEngine\GameEngine.Core\Shaders\**\*"
                 Link="Shaders\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The data files (phase-5-save.md 5.3, 5.4; the content rework, 1f): the files in
         Data\ are the master copy of every number, relation, weapon and dungeon, edited by
         hand. The game is built with each inside (EmbeddedResource, read by ShippedData),
         and plays that built-in copy wherever the copy beside the executable is missing or
         cannot be read. Each is also copied beside the executable, where the game reads it
         once at startup and a playtest edits it: PreserveNewest replaces that copy whenever
         its master is newer, and leaves it alone otherwise. -->
    <ItemGroup>
        <None Remove="Data\**" />
        <Content Include="Data\*.json"
                 Link="%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" />
        <EmbeddedResource Include="Data\*.json"
                          LogicalName="DistanceRPG.Data.%(Filename)%(Extension)" />
    </ItemGroup>

</Project>
