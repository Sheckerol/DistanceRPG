  /* The unique table (phase-1-weapons.md 1.5): each a variant with one modifier it already carries
     raised to x3 - or, for a Light-forged one, the signature raised to x2 and paid for in souls -
     and a soul no other weapon can have; a caster unique raises nothing and puts the whole artifact
     in its enchantments. Everything else is its variant's - the class, the statline and the shape -
     and is not written here. The three the docs leave unnamed carry provisional names. */
  "uniques": [
    /* Absorbs 9, shoves what it stops, and refuses to let you die. */
    {
      "id": "the_bulwark",
      "name": "The Bulwark", "derivedFrom": "tower_guard", "raises": { "Block": 3 },
      "enchantments": [{ "id": "sturdy" }]
    },
    /* Four throws that barely cost anything to make. */
    {
      "id": "feathered_death",
      "name": "Feathered Death", "derivedFrom": "bandolier", "raises": { "Charges": 3 },
      "enchantments": [{ "id": "weightless" }]
    },
    /* Ignores 9 Block across the swing. */
    {
      "id": "shieldbreaker",
      "name": "Shieldbreaker", "derivedFrom": "reaver", "raises": { "Splitting": 3 },
      "enchantments": [{ "id": "momentum" }]
    },
    /* Finds the gap on 17+, and every kill funds the enchantments doing it. */
    {
      "id": "widowmaker",
      "name": "Widowmaker", "derivedFrom": "assassins_fang", "raises": { "CritWindow": 3 },
      "enchantments": [{ "id": "siphon" }]
    },
    /* Three retaliations at full reach, from a line that cannot be moved. */
    {
      "id": "hoplites_wall",
      "name": "Hoplite's Wall", "derivedFrom": "phalanx_spear", "raises": { "Brace": 3 },
      "enchantments": [{ "id": "immovable" }]
    },
    /* +3 a tile, and the shot does not stop at the first body. */
    {
      "id": "stormcrow",
      "name": "Stormcrow", "derivedFrom": "longbow", "raises": { "Longshot": 3 },
      "enchantments": [{ "id": "piercing" }]
    },
    /* Stabs itself a shield: three souls in a line - the Light shape, x2 buying three. */
    {
      "id": "flensing_knife_unique", /* provisional */
      "name": "Nameless Knife", "derivedFrom": "flensing_knife", "raises": { "CritWindow": 2 },
      "enchantments": [{ "id": "serrated" }, { "id": "vampiric", "tier": 3 }, { "id": "overheal" }]
    },
    /* A rot that starts where an ordinary staff's ends. */
    {
      "id": "rotwood",
      "name": "Rotwood", "derivedFrom": "staff_of_blight", "raises": {},
      "enchantments": [{ "id": "poison", "tier": 3 }]
    },
    /* A beam of plasma: two elements, each answering the chart. */
    {
      "id": "the_long_candle",
      "name": "The Long Candle", "derivedFrom": "wand_of_the_beam", "raises": {},
      "enchantments": [{ "id": "shocking" }, { "id": "flaming" }]
    },
    /* A circle that keeps burning after it lands. */
    {
      "id": "wand_of_the_nova_unique", /* provisional */
      "name": "Nameless Nova", "derivedFrom": "wand_of_the_nova", "raises": {},
      "enchantments": [{ "id": "flaming" }, { "id": "burning" }]
    },
    /* Healing that stops being wasted on the healthy. */
    {
      "id": "staff_of_renewal_unique", /* provisional */
      "name": "Nameless Renewal", "derivedFrom": "staff_of_renewal", "raises": {},
      "enchantments": [{ "id": "regeneration" }, { "id": "overheal" }]
    }
  ]
}
