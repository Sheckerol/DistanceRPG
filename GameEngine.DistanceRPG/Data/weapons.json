/*
 * weapons.json - every weapon: the eight classes, the thirty-two variants, four to each class, and
 * the uniques.
 *
 * Read once, when the game starts, after restricted.json. A weapon is checked, never clamped: a
 * class the game cannot level or cast with, a spread restricted.json does not allow, a modifier
 * forged past its limit, a variant that is not its class plus one modifier, a unique that is not
 * its variant raised, or a field the game does not know stops the game on a screen naming the
 * file, the class or the weapon and the rule - and, when a relation refused it, that
 * restricted.json relation. Comments and trailing commas are fine. A weapon is an edit here, never
 * a rebuild: start the game again to play it.
 *
 * classes: every class once - Dagger, Sword, Spear, Axe, Ranged, Throwing, Staff and Wand - with
 * what every weapon of it shares. kind: melee, ranged or caster, in lower case - the Staff and the
 * Wand cast, and no other class does. stats: the stats it levels on, the best of them counting -
 * STR, DEX or INT; CON levels no weapon. signature: the modifier the class is named for, which its
 * Purity variant deepens and a dungeon's theme is drawn from; null for a caster. baseline: the
 * modifiers every weapon of the class is forged with, each to its stack count - a martial class's
 * signature and one more; a caster's whatever the forge allows, one modifier at least, and every
 * staff or wand carries it and nothing else - so re-basing a class is one edit, here. range: the
 * reach, in logic units (32 a tile). damage: a hit, before modifiers. cost: the movement an attack
 * or a cast takes. manaCost: the mana a cast takes, 0 for a martial class. dropOrder, on the Staff
 * and the Wand alone: the ids of the variants a drop of the class rolls between, in the order the
 * draw counts them - each a variant of that class, none twice. A staff or a wand it leaves out
 * never drops: add one to variants, then to dropOrder. Reordering the variants below moves no
 * drop; an edit to dropOrder moves what a dummy not yet collected in a saved campaign drops. A
 * martial class draws one variant per role instead, and names no dropOrder.
 *
 * variants: what a drop or a dummy carries. id: what everything names the weapon by - the starting
 * party (code), a drop, a save. name: what the screen calls it. class: one of the classes above.
 * role: a martial variant's - Efficiency, Purity, Control or Support - or null for a caster. adds:
 * the modifiers it adds to its class's baseline, each to its stack count and summed onto it - {}
 * for a caster. enchantments: what it arrives with, in order, each an id from the game's
 * enchantment catalogue with its tier (1 when left out). shape: a wand's area - Blast (radius,
 * targetReach), Cone (length, angleDegrees), Beam (length, width) or Nova (radius), in logic
 * units - or null. range, damage, cost and manaCost may be left out, and are its class's then; one
 * given plays for that variant alone, in place of its class's.
 *
 * uniques: the artifacts, each made from a variant. id, name, enchantments: as a variant's.
 * derivedFrom: the variant it is made from; it takes that variant's class, statline and shape.
 * raises: the modifiers it raises, each set to the stack count given - not added to - so a unique
 * that raises Block to 3 carries Block x3; {} for a caster, which raises nothing.
 *
 * arming_sword (what a dummy holds) and staff_of_renewal (a crowded room's healer) are named by
 * the game's code and must be here, and so must a variant of each class a dummy can be placed
 * holding - Dagger, Sword, Spear, Axe and Throwing. A weapon whose id is marked provisional is a
 * first guess the docs did not fix, expected to move after play.
 *
 * GameEngine.DistanceRPG/Data/weapons.json is the master copy: the game is built with it inside,
 * and plays that built-in copy whenever the copy beside the executable is missing or cannot be
 * read (the screen says so). A build copies it beside the executable
 * (bin/Debug/net10.0/weapons.json - the log prints its full path), where a playtest edits it. A
 * weapon worth keeping is made in the master, and the game rebuilt; a build replaces the copy
 * beside the executable whenever the master is newer. DistanceRPG --write-data <folder> writes
 * the built-in copies out.
 */
{
  /* The statlines are the class tables' (phase-1-weapons.md 1.2, 1.3, 1.4), and every variant is
     its class baseline plus one added modifier type. The cost column is a base cost: Light resolves
     an Efficiency weapon down by 10% at instantiation, never here. */
  "classes": {
    /* Dagger (DEX): 19-20 to crit, x3 when it lands. */
    "Dagger": {
      "kind": "melee", "stats": ["DEX"], "signature": "CritWindow",
      "baseline": { "CritWindow": 1, "CritMultiplier": 1 },
      "range": 40, "damage": 15, "cost": 30, "manaCost": 0
    },
    /* Sword and Shield: the better of STR and DEX, since a shield bash is whichever of the two you
       have. You stop them, then you move them. */
    "Sword": {
      "kind": "melee", "stats": ["STR", "DEX"], "signature": "Block",
      "baseline": { "Block": 1, "Push": 1 },
      "range": 80, "damage": 10, "cost": 50, "manaCost": 0
    },
    /* Spear (STR): reach 128, exactly four tiles, so Longshot's tile count is a rule. */
    "Spear": {
      "kind": "melee", "stats": ["STR"], "signature": "Brace",
      "baseline": { "Brace": 1, "Longshot": 1 },
      "range": 128, "damage": 7, "cost": 55, "manaCost": 0
    },
    /* Axe (STR): nobody walks away from an axe. */
    "Axe": {
      "kind": "melee", "stats": ["STR"], "signature": "Cleave",
      "baseline": { "Cleave": 1, "Opportunist": 1 },
      "range": 60, "damage": 18, "cost": 60, "manaCost": 0
    },
    /* Ranged (DEX): damage 5 is meant to look low; the range curve does the work. */
    "Ranged": {
      "kind": "ranged", "stats": ["DEX"], "signature": "Longshot",
      "baseline": { "CritWindow": 1, "Longshot": 1 },
      "range": 320, "damage": 5, "cost": 30, "manaCost": 0
    },
    /* Throwing (STR): 15 a throw is honest only because Charges caps it. */
    "Throwing": {
      "kind": "ranged", "stats": ["STR"], "signature": "Charges",
      "baseline": { "CritMultiplier": 1, "Charges": 1 },
      "range": 190, "damage": 9, "cost": 15, "manaCost": 0
    },
    /* Staff (INT): Resonant x1 plus the effect it casts, fixed by variant. Range 100, cost 40 and
       20 mana a cast - the Staff of Renewal and the Staff of Mire name their own mana. */
    "Staff": {
      "kind": "caster", "stats": ["INT"], "signature": null,
      "baseline": { "Resonant": 1 },
      "range": 100, "damage": 0, "cost": 40, "manaCost": 20,
      "dropOrder": ["staff_of_renewal", "staff_of_warding", "staff_of_blight", "staff_of_mire"]
    },
    /* Wand (INT): Resonant x1 plus an element supplied when it drops; four shapes, in logic units. */
    "Wand": {
      "kind": "caster", "stats": ["INT"], "signature": null,
      "baseline": { "Resonant": 1 },
      "range": 160, "damage": 8, "cost": 45, "manaCost": 20,
      "dropOrder": ["wand_of_the_blast", "wand_of_the_cone", "wand_of_the_beam", "wand_of_the_nova"]
    }
  },

  /* The four roles add Light x1 (Efficiency), another stack of the signature (Purity), something
     that degrades the enemy (Control) or something that helps the party (Support); a caster varies
     by the effect it casts or the shape it covers instead, and has no role. */
  "variants": [
    /* ---- Dagger ---- */
    {
      "id": "flensing_knife",
      "name": "Flensing Knife", "class": "Dagger", "role": "Efficiency", "adds": { "Light": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "assassins_fang",
      "name": "Assassin's Fang", "class": "Dagger", "role": "Purity", "adds": { "CritWindow": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "disarming_kris",
      "name": "Disarming Kris", "class": "Dagger", "role": "Control", "adds": { "CritWeaken": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "weakspot_stiletto",
      "name": "Weakspot Stiletto", "class": "Dagger", "role": "Support", "adds": { "CritSunder": 1 },
      "enchantments": [], "shape": null
    },
    /* ---- Sword ---- */
    {
      "id": "arming_sword",
      "name": "Arming Sword", "class": "Sword", "role": "Efficiency", "adds": { "Light": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "tower_guard",
      "name": "Tower Guard", "class": "Sword", "role": "Purity", "adds": { "Block": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "riposte_blade",
      "name": "Riposte Blade", "class": "Sword", "role": "Control", "adds": { "Riposte": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "wardens_shield",
      "name": "Warden's Shield", "class": "Sword", "role": "Support", "adds": { "BlockWeaken": 1 },
      "enchantments": [], "shape": null
    },
    /* ---- Spear ---- */
    {
      "id": "skirmishers_pike",
      "name": "Skirmisher's Pike", "class": "Spear", "role": "Efficiency", "adds": { "Light": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "phalanx_spear",
      "name": "Phalanx Spear", "class": "Spear", "role": "Purity", "adds": { "Brace": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "halberd",
      "name": "Halberd", "class": "Spear", "role": "Control", "adds": { "Push": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "pinning_lance",
      "name": "Pinning Lance", "class": "Spear", "role": "Support", "adds": { "Pin": 1 },
      "enchantments": [], "shape": null
    },
    /* ---- Axe ---- */
    {
      "id": "hatchet",
      "name": "Hatchet", "class": "Axe", "role": "Efficiency", "adds": { "Light": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "great_axe",
      "name": "Great Axe", "class": "Axe", "role": "Purity", "adds": { "Cleave": 1 },
      "enchantments": [], "shape": null
    },
    /* The Reaver forges Splitting x2. */
    {
      "id": "reaver",
      "name": "Reaver", "class": "Axe", "role": "Control", "adds": { "Splitting": 2 },
      "enchantments": [], "shape": null
    },
    {
      "id": "routing_axe",
      "name": "Routing Axe", "class": "Axe", "role": "Support", "adds": { "Rout": 1 },
      "enchantments": [], "shape": null
    },
    /* ---- Ranged ---- */
    {
      "id": "hunting_bow",
      "name": "Hunting Bow", "class": "Ranged", "role": "Efficiency", "adds": { "Light": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "longbow",
      "name": "Longbow", "class": "Ranged", "role": "Purity", "adds": { "Longshot": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "pinning_bow",
      "name": "Pinning Bow", "class": "Ranged", "role": "Control", "adds": { "Pin": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "crossbow",
      "name": "Crossbow", "class": "Ranged", "role": "Support", "adds": { "Overwatch": 1 },
      "enchantments": [], "shape": null
    },
    /* ---- Throwing ---- */
    {
      "id": "darts",
      "name": "Darts", "class": "Throwing", "role": "Efficiency", "adds": { "Light": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "bandolier",
      "name": "Bandolier", "class": "Throwing", "role": "Purity", "adds": { "Charges": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "harpoon",
      "name": "Harpoon", "class": "Throwing", "role": "Control", "adds": { "Drag": 1 },
      "enchantments": [], "shape": null
    },
    {
      "id": "softening_javelins",
      "name": "Softening Javelins", "class": "Throwing", "role": "Support", "adds": { "Softening": 1 },
      "enchantments": [], "shape": null
    },
    /* ---- Staff ---- */
    {
      "id": "staff_of_renewal",
      "name": "Staff of Renewal", "class": "Staff", "role": null, "adds": {}, "manaCost": 15,
      "enchantments": [{ "id": "regeneration" }], "shape": null
    },
    {
      "id": "staff_of_warding",
      "name": "Staff of Warding", "class": "Staff", "role": null, "adds": {},
      "enchantments": [{ "id": "ward" }], "shape": null
    },
    {
      "id": "staff_of_blight",
      "name": "Staff of Blight", "class": "Staff", "role": null, "adds": {},
      "enchantments": [{ "id": "poison" }], "shape": null
    },
    {
      "id": "staff_of_mire",
      "name": "Staff of Mire", "class": "Staff", "role": null, "adds": {}, "manaCost": 25,
      "enchantments": [{ "id": "mire" }], "shape": null
    },
    /* ---- Wand ---- */
    {
      "id": "wand_of_the_blast",
      "name": "Wand of the Blast", "class": "Wand", "role": null, "adds": {},
      "enchantments": [], "shape": { "kind": "Blast", "radius": 48, "targetReach": 160 }
    },
    {
      "id": "wand_of_the_cone",
      "name": "Wand of the Cone", "class": "Wand", "role": null, "adds": {},
      "enchantments": [], "shape": { "kind": "Cone", "length": 128, "angleDegrees": 90 }
    },
    {
      "id": "wand_of_the_beam",
      "name": "Wand of the Beam", "class": "Wand", "role": null, "adds": {},
      "enchantments": [], "shape": { "kind": "Beam", "length": 224, "width": 32 }
    },
    {
      "id": "wand_of_the_nova",
      "name": "Wand of the Nova", "class": "Wand", "role": null, "adds": {},
