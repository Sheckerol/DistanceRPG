/*
 * dungeons.json - the dungeons the screen between runs lists, in its order, each with its boss.
 *
 * Read once, when the game starts, after weapons.json. A dungeon is checked, never clamped: a
 * theme that is no class's signature, a boss floor range that is inverted or deep enough to pay
 * a farm's stacks, a boss without its theme, two dungeons that retire on clear, or a field the
 * game does not know stops the game on a screen naming the file, the dungeon and the rule. Every
 * number here has a range - README.md lists each, with why - and one outside it stops the game the
 * same way, naming the dungeon, the field, the number and the range. Every dungeon names all eight
 * fields, and its boss all five; comments and trailing commas are fine. A dungeon is an edit here,
 * never a rebuild: start the game again to play it.
 *
 * id: what everything names the dungeon by - a lock, a save. name: what the screen calls it.
 * theme: a modifier - the boss carries it whatever it holds and forges it onto its drop, and every
 * other drop there may roll it; a class's signature, so the dungeon has one unique to hunt.
 * attunement: the damage type everything it spawns is attuned to (Flaming, Cold, Shocking or
 * Acidic), or null. bossFloorMin, bossFloorMax: the floors the boss is rolled between, or null
 * for tuning.json's BossFloorMin and BossFloorMax. boss: its id, name, maxHp, movementBudget (in
 * logic units a turn, 32 a tile) and innate modifiers, each to its stack count, the theme among
 * them. retiresOnClear: beating the boss closes the dungeon for good - the tutorial's, and only
 * one dungeon may.
 *
 * There is no drop table: what a boss drops is computed from its theme and restricted.json, so a
 * relation edited there moves it with no edit here. A dungeon or a boss whose id is marked
 * provisional is a first guess the docs did not fix, expected to move after play.
 *
 * GameEngine.DistanceRPG/Data/dungeons.json is the master copy: the game is built with it
 * inside, and plays that built-in copy whenever the copy beside the executable is missing or
 * cannot be read (the screen says so). A build copies it beside the executable
 * (bin/Debug/net10.0/dungeons.json - the log prints its full path), where a playtest edits it. A
 * dungeon worth keeping is made in the master, and the game rebuilt; a build replaces the copy
 * beside the executable whenever the master is newer. DistanceRPG --write-data <folder> writes
 * the built-in copies out.
 */
{
  /* Each theme is a class signature with a unique to hunt: the Purity variant of the theme's own
     class, grafted by the boss, is that class's unique by arithmetic (phase-4-floors.md 4.3). Only
     the tutorial's golem is the docs' - 80 HP, a movement budget of 40, Block x3 innate
     (phase-5-save.md). Everything else here - the four dungeons, their names, their bosses' names
     and statlines - is provisional: picked so the hub has somewhere to go, and expected to move
     after play. settled.md's first playable hub has six; the two missing need content that does
     not exist yet (a Great Axe unique for Cleave, or a repeated theme), and Phase 6b completes the
     roster. No dungeon here is attuned: attunement is its own field, and none is set yet. A floor
     range left null reads tuning.json's; the tutorial pins both ends to 2 and is the one dungeon
     that retires on its clear. */
  "dungeons": [
    {
      "id": "tutorial",
      "name": "The Tutorial",
      "theme": "Block",
      "attunement": null,
      "bossFloorMin": 2,
      "bossFloorMax": 2,
      /* The docs' golem: slow, and Block x3 whatever it holds. */
      "boss": {
        "id": "stone_golem",
        "name": "Stone Golem",
        "maxHp": 80,
        "movementBudget": 40,
        "innate": { "Block": 3 }
      },
      "retiresOnClear": true
    },
    {
      "id": "spear_hall", /* provisional */
      "name": "The Spear Hall",
      "theme": "Brace",
      "attunement": null,
      "bossFloorMin": null,
      "bossFloorMax": null,
      /* Drops daggers, swords and spears; hunts Hoplite's Wall. */
      "boss": {
        "id": "spear_warden", /* provisional */
        "name": "Spear Warden",
        "maxHp": 200,
        "movementBudget": 70,
        "innate": { "Brace": 3 }
      },
      "retiresOnClear": false
    },
    {
      "id": "long_gallery", /* provisional */
      "name": "The Long Gallery",
      "theme": "Longshot",
      "attunement": null,
      "bossFloorMin": null,
      "bossFloorMax": null,
      /* Drops all eight classes; hunts Stormcrow, a bow no enemy wields. */
      "boss": {
        "id": "gallery_marksman", /* provisional */
        "name": "Gallery Marksman",
        "maxHp": 200,
        "movementBudget": 70,
        "innate": { "Longshot": 3 }
      },
      "retiresOnClear": false
    },
    {
      "id": "knife_warrens", /* provisional */
      "name": "The Knife Warrens",
      "theme": "CritWindow",
      "attunement": null,
      "bossFloorMin": null,
      "bossFloorMax": null,
      /* Drops all eight classes; hunts Widowmaker. */
      "boss": {
        "id": "knife_mother", /* provisional */
        "name": "Knife Mother",
        "maxHp": 200,
        "movementBudget": 70,
        "innate": { "CritWindow": 3 }
      },
      "retiresOnClear": false
    },
    {
      "id": "quiver_pits", /* provisional */
      "name": "The Quiver Pits",
      "theme": "Charges",
      "attunement": null,
      "bossFloorMin": null,
      "bossFloorMax": null,
      /* Charges is forged-only, so it drops throwing weapons alone; hunts Feathered Death. */
      "boss": {
        "id": "quiver_keeper", /* provisional */
        "name": "Quiver Keeper",
        "maxHp": 200,
        "movementBudget": 70,
        "innate": { "Charges": 3 }
      },
      "retiresOnClear": false
    }
  ]
}
